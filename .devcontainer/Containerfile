ARG VARIANT=bookworm
FROM mcr.microsoft.com/devcontainers/base:${VARIANT}

ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PLATFORMIO_CORE_DIR=/home/vscode/.pio-core
ENV PATH="/home/vscode/.platformio/penv/bin:/usr/local/share/npm-global/bin:${PATH}"

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
      build-essential \
      clang \
      git-lfs \
      python3-venv \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      libpixman-1-dev \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get -y install --no-install-recommends nodejs \
 && git lfs install --system \
 && mkdir -p /usr/local/share/npm-global /home/vscode/.pio-core \
 && chown -R vscode:vscode /usr/local/share/npm-global /home/vscode/.pio-core \
 && rm -rf /var/lib/apt/lists/*

# Install PlatformIO CLI
USER vscode
RUN curl -fsSL -o /tmp/get-platformio.py https://raw.githubusercontent.com/platformio/platformio-core-installer/master/get-platformio.py \
 && python3 /tmp/get-platformio.py \
 && rm -f /tmp/get-platformio.py \
 && echo 'export PATH="$HOME/.platformio/penv/bin:/usr/local/share/npm-global/bin:$PATH"' | tee -a /home/vscode/.bashrc /home/vscode/.zshrc > /dev/null
