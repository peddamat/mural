{
	"name": "Mural (wslc)",
	"build": {
		"dockerfile": "Containerfile",
		"context": ".",
		"args": {
			"VARIANT": "bookworm"
		}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	"initializeCommand": [
		"powershell",
		"-NoProfile",
		"-Command",
		"New-Item -ItemType Directory -Force -Path (Join-Path $env:USERPROFILE '.claude') | Out-Null"
	],
	"mounts": [
		"source=${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
		"source=mural-pio-core,target=/home/vscode/.pio-core,type=volume"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"platformio.platformio-ide",
				"Anthropic.claude-code"
			]
		}
	},
	"forwardPorts": [
		8008,
		5173
	],
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.pio-core && npm i --prefix worker && npm i --prefix ui && npm i -g playwright@1.63.0 && playwright install --with-deps chromium"
}
