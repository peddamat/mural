					"${workspaceFolder}/.devcontainer/wslc-pio.ps1",
					"build",
					"hw649_esp8266"
				]
			},
			"linux": {
				"command": "bash",
				"args": [
					"-lc",
					"set -e; [ -d worker/node_modules ] || npm i --prefix worker; [ -d ui/node_modules ] || npm i --prefix ui; pio run -e hw649_esp8266 && MURAL_SKIP_WEB_BUILD=1 pio run -e hw649_esp8266 -t buildfs"
				]
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Firmware: Build ESP32 (FluidNC + Merged Bin)",
			"type": "shell",
			"group": "build",
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.devcontainer/wslc-pio.ps1",
					"build",
					"esp32dev"
				]
			},
			"linux": {
				"command": "bash",
				"args": [
					"-lc",
					"set -e; [ -d worker/node_modules ] || npm i --prefix worker; [ -d ui/node_modules ] || npm i --prefix ui; pio run -e esp32dev -t mergebin"
				]
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Firmware: Upload HW-649 Uno (ATmega328P)",
			"type": "shell",
			"dependsOn": [
				"Firmware: Build HW-649 Uno (ATmega328P)"
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.devcontainer/wslc-pio.ps1",
					"upload",
					"hw649_uno"
				]
			},
			"linux": {
				"command": "bash",
				"args": [
					"-lc",
					"if ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1; then pio run -e hw649_uno -t nobuild -t upload; else echo 'No USB serial device found in container (wslc does not pass host USB ports). Run this Upload task from VS Code on Windows.' >&2; exit 1; fi"
				]
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
