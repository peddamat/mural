{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Firmware: Build All (HW-649 Uno + ESP8266 + LittleFS)",
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.devcontainer/wslc-pio.ps1",
					"build",
					"all"
				]
			},
			"linux": {
				"command": "bash",
				"args": [
					"-lc",
					"set -e; [ -d worker/node_modules ] || npm i --prefix worker; [ -d ui/node_modules ] || npm i --prefix ui; pio run -e hw649_uno && pio run -e hw649_esp8266 && MURAL_SKIP_WEB_BUILD=1 pio run -e hw649_esp8266 -t buildfs"
				]
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Firmware: Build HW-649 Uno (ATmega328P)",
			"type": "shell",
			"group": "build",
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.devcontainer/wslc-pio.ps1",
					"build",
					"hw649_uno"
				]
			},
			"linux": {
				"command": "pio",
				"args": [
					"run",
					"-e",
					"hw649_uno"
				]
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Firmware: Build HW-649 ESP8266 (Firmware + LittleFS)",
